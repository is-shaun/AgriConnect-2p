# Copy to backend/.env and fill in. Never commit the real .env file.
APP_ENV=development

# MySQL connection (create the database and user first – see README "Set up MySQL")
DATABASE_URL=mysql+pymysql://agri_user:CHANGE_ME@127.0.0.1:3306/agriconnect?charset=utf8mb4

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (>= 32 chars) when APP_ENV=production; development falls back to an insecure dev key.
SECRET_KEY=
JWT_SECRET_KEY=

# Must list the exact frontend origin(s), comma separated
CORS_ORIGINS=http://localhost:5173

# Cookies: keep true in production (HTTPS). Development defaults to false for http://localhost.
# JWT_COOKIE_SECURE=false
JWT_ACCESS_HOURS=8

# Optional
# MODEL_PATH=../ml/artifacts/price_model.joblib
# RATE_LIMIT_ENABLED=true
# LOG_LEVEL=INFO

# Only for running the test-suite against MySQL instead of in-memory SQLite:
# TEST_DATABASE_URL=mysql+pymysql://agri_test:CHANGE_ME@127.0.0.1:3306/agriconnect_test?charset=utf8mb4
